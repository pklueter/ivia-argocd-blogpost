# -------------------------------------------------------
# Copy this file to .env and fill in all values before
# running any of the scripts in this folder.
# NEVER commit .env to version control.
# -------------------------------------------------------

# ----- Namespace -----
NAMESPACE=verify

# ----- Stage (matches overlays/<stage> and iviaop/stage_config/<stage>) -----
STAGE=dev

# ----- Domains -----
DOMAIN_WRP=verify.yourdomain.com
DOMAIN_API=api.yourdomain.com
DOMAIN_OIDCRP=rp.yourdomain.com
DOMAIN_LMI=lmi.yourdomain.com

# ----- IVIA Admin (LMI) -----
IVIA_ADMIN_PWD=changeme

# ----- IVIA Config Service -----
CFGSVC_PWD=changeme

# ----- PostgreSQL -----
PSQL_PWD=changeme

# ----- OIDC Provider (iviaop) -----
# Passwords used in the op-config ConfigMap (secrets referenced from the YAML)
OP_DB_PASSWORD=${PSQL_PWD}
OP_LDAP_PASSWORD=changeme

# ----- IVD (LDAP) -----
IVD_ADMIN_PWD=changeme
# Path to the IVD license file downloaded from IBM Passport Advantage
IVD_LICENSE_FILE=./ivd/ivd-10.0.0_license_key_limited.txt
